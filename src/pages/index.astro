---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const academicProjects = allProjects.filter(p => p.data.category === 'academic');
const personalProjects = allProjects.filter(p => p.data.category === 'personal');

const popularTech = ["TypeScript", "React", "Astro", "Node.js", "PostgreSQL", "Python", "Docker", "TailwindCSS", "Rust"];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getHref = (href: string) => href === '/' ? (base ? `${base}/` : '/') : `${base}${href}`;
---

<Layout title={`${siteConfig.name} | Portafolio de Software & Proyectos`}>
  
  <!-- HERO SECTION -->
  <section class="py-12 md:py-20 flex flex-col items-start justify-center">
    
    <!-- Badge de Estado -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200/80 dark:border-teal-800/80 mb-6 shadow-xs animate-pulse">
      <span class="w-2 h-2 rounded-full bg-teal-500"></span>
      <span>Disponible para proyectos y pasantías</span>
    </div>

    <!-- Título Principal con Gradiente -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15] max-w-4xl">
      Hola, soy <span class="text-gradient-brand">{siteConfig.name}</span>.<br class="hidden sm:inline" />
      Desarrollo software con enfoque académico y práctico.
    </h1>

    <!-- Subtítulo / Bio Breve -->
    <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
      Estudiante de <strong class="text-slate-900 dark:text-white">{siteConfig.career}</strong> en <strong class="text-slate-900 dark:text-white">{siteConfig.university}</strong> ({siteConfig.currentSemester}). Aquí encontrarás tanto los proyectos desarrollados en mis <strong>materias universitarias</strong> como mis <strong>proyectos personales</strong>.
    </p>

    <!-- Botones de Acción / CTA -->
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href={getHref('/projects')}
        class="px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm shadow-md hover:shadow-teal-500/25 transition-all flex items-center gap-2 group"
      >
        <span>Explorar Todos los Proyectos</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <a
        href={getHref('/about')}
        class="px-6 py-3 rounded-xl glass-card glass-card-hover font-semibold text-sm text-slate-700 dark:text-slate-300 transition-all"
      >
        Conocer más sobre mí
      </a>

      <a
        href={getHref('/contact')}
        class="px-6 py-3 rounded-xl border border-slate-300/80 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-900 font-semibold text-sm text-slate-700 dark:text-slate-300 transition-all"
      >
        Contactar
      </a>
    </div>

    <!-- TARJETAS DE ACCESO RÁPIDO A MATERIAS VS PERSONALES -->
    <div class="mt-14 w-full grid grid-cols-1 md:grid-cols-2 gap-5">
      
      <!-- Tarjeta Materias -->
      <a 
        href={getHref('/projects?category=academic')} 
        class="group p-6 rounded-2xl bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent dark:from-amber-950/40 dark:via-amber-950/20 dark:to-transparent border border-amber-300/50 dark:border-amber-800/60 hover:border-amber-400 dark:hover:border-amber-700 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-2xl">
            🎓
          </div>
          <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-900/80 text-amber-800 dark:text-amber-200">
            {academicProjects.length} Proyectos
          </span>
        </div>
        <h3 class="mt-4 text-xl font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
          Proyectos de Materias Universitarias &rarr;
        </h3>
        <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
          Entregas de asignaturas: Bases de Datos, Algoritmos, Compiladores, Redes y Sistemas Embebidos con documentación académica.
        </p>
      </a>

      <!-- Tarjeta Personales -->
      <a 
        href={getHref('/projects?category=personal')} 
        class="group p-6 rounded-2xl bg-gradient-to-br from-blue-500/10 via-blue-500/5 to-transparent dark:from-blue-950/40 dark:via-blue-950/20 dark:to-transparent border border-blue-300/50 dark:border-blue-800/60 hover:border-blue-400 dark:hover:border-blue-700 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-xl bg-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl">
            🚀
          </div>
          <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-blue-100 dark:bg-blue-900/80 text-blue-800 dark:text-blue-200">
            {personalProjects.length} Proyectos
          </span>
        </div>
        <h3 class="mt-4 text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Proyectos Personales & Side Projects &rarr;
        </h3>
        <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
          Iniciativas propias, aplicaciones web fullstack, herramientas CLI, prototipos de IA y contribuciones open-source.
        </p>
      </a>

    </div>

  </section>

  <!-- SECCIÓN: PROYECTOS DESTACADOS -->
  <section class="py-12 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <SectionTitle
        badge="Lo Mejor de mi Trabajo"
        title="Proyectos Destacados"
        subtitle="Una selección equilibrada entre retos académicos universitarios y proyectos creados por iniciativa propia."
      />
      <a 
        href={getHref('/projects')} 
        class="inline-flex items-center gap-1.5 text-sm font-bold text-teal-600 dark:text-teal-400 hover:underline mb-8 sm:mb-12 self-start sm:self-auto"
      >
        <span>Ver galería completa ({allProjects.length})</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Grid de Proyectos Destacados -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- SECCIÓN: STACK TECNOLÓGICO Y MATERIAS -->
  <section class="py-12 border-t border-slate-200/80 dark:border-slate-800/80">
    <SectionTitle
      badge="Conocimientos Técnicos"
      title="Tecnologías & Áreas de Estudio"
      subtitle="Herramientas y lenguajes aplicados en proyectos prácticos y asignaturas de la carrera."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Columna 1: Frontend & UI -->
      <div class="p-6 rounded-2xl glass-card space-y-4">
        <div class="w-10 h-10 rounded-xl bg-teal-100 dark:bg-teal-950 flex items-center justify-center text-teal-600 dark:text-teal-400 font-bold text-lg">
          ⚡
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Desarrollo Frontend</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Creación de interfaces web modernas, reactivas, accesibles y optimizadas en rendimiento.
        </p>
        <div class="flex flex-wrap gap-1.5 pt-2">
          {["Astro", "React", "TypeScript", "Tailwind CSS", "Next.js", "HTML5/CSS3"].map(t => (
            <TechBadge name={t} />
          ))}
        </div>
      </div>

      <!-- Columna 2: Backend & Datos -->
      <div class="p-6 rounded-2xl glass-card space-y-4">
        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950 flex items-center justify-center text-amber-600 dark:text-amber-400 font-bold text-lg">
          🗄️
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Backend & Bases de Datos</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Diseño de APIs REST, modelado relacional, optimización de queries y seguridad.
        </p>
        <div class="flex flex-wrap gap-1.5 pt-2">
          {["Node.js", "Express", "PostgreSQL", "Python", "FastAPI", "SQLite", "Docker"].map(t => (
            <TechBadge name={t} />
          ))}
        </div>
      </div>

      <!-- Columna 3: Ciencias de la Computación -->
      <div class="p-6 rounded-2xl glass-card space-y-4">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold text-lg">
          🧠
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Fundamentos & Algoritmos</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Estructuras de datos avanzadas, análisis de complejidad, compiladores y testing.
        </p>
        <div class="flex flex-wrap gap-1.5 pt-2">
          {["C++", "Rust", "Estructuras de Datos", "Algoritmos de Grafos", "Git/GitHub", "Linux"].map(t => (
            <TechBadge name={t} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- BANNER CTA DE CONTACTO -->
  <section class="my-12 p-8 md:p-12 rounded-3xl bg-gradient-to-r from-teal-900 via-slate-900 to-blue-950 text-white relative overflow-hidden shadow-xl">
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-teal-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative z-10 max-w-2xl">
      <span class="text-xs font-mono uppercase tracking-widest text-teal-400 font-bold">¿Colaboramos juntos?</span>
      <h2 class="mt-2 text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
        ¿Interesado en mi trabajo o tienes una oportunidad en mente?
      </h2>
      <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
        Estoy disponible para pasantías, proyectos de desarrollo de software o colaboración en iniciativas innovadoras.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a 
          href={getHref('/contact')} 
          class="px-6 py-3 rounded-xl bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-sm transition-all shadow-md"
        >
          Ponerse en Contacto
        </a>
        <a 
          href={siteConfig.github} 
          target="_blank" 
          rel="noreferrer"
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-medium text-sm transition-all border border-white/20"
        >
          Ver Perfil de GitHub &rarr;
        </a>
      </div>
    </div>
  </section>

</Layout>
