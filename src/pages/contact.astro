---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { siteConfig } from '../config/site';
---

<Layout 
  title={`Contacto | ${siteConfig.name}`}
  description="Ponte en contacto para oportunidades de proyectos, pasantías o consultas sobre mis proyectos académicos."
>
  <div class="py-6 max-w-4xl mx-auto">
    <SectionTitle
      badge="Hablemos"
      title="Contacto & Colaboraciones"
      subtitle="¿Tienes una duda sobre alguno de mis proyectos, una propuesta de colaboración o una vacante?"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
      
      <!-- Información Directa y Tarjetas de Enlace -->
      <div class="space-y-6">
        
        <!-- Tarjeta Email -->
        <div class="p-6 rounded-2xl glass-card space-y-3">
          <div class="w-10 h-10 rounded-xl bg-teal-100 dark:bg-teal-950 flex items-center justify-center text-teal-600 dark:text-teal-400 font-bold">
            ✉️
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Correo Electrónico</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Respondo habitualmente en menos de 24 horas.
          </p>
          <div class="flex items-center gap-2 pt-1">
            <a 
              href={`mailto:${siteConfig.email}`}
              class="text-sm font-semibold text-teal-600 dark:text-teal-400 hover:underline"
            >
              {siteConfig.email}
            </a>
            <button
              id="copy-email-btn"
              type="button"
              class="px-2 py-1 rounded-md text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            >
              Copiar
            </button>
          </div>
          <span id="copy-feedback" class="text-[11px] text-teal-600 dark:text-teal-400 font-medium hidden">
            ✓ ¡Correo copiado al portapapeles!
          </span>
        </div>

        <!-- Tarjeta LinkedIn & GitHub -->
        <div class="p-6 rounded-2xl glass-card space-y-4">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Redes Profesionales</h3>
          
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors group"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold text-xs">
                in
              </div>
              <div>
                <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">LinkedIn</span>
                <span class="text-xs text-slate-400 block">Conecta profesionalmente</span>
              </div>
            </div>
            <span class="text-xs font-semibold text-slate-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>

          <a
            href={siteConfig.github}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors group"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-800 flex items-center justify-center text-slate-800 dark:text-slate-200 font-bold text-xs">
                GH
              </div>
              <div>
                <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">GitHub</span>
                <span class="text-xs text-slate-400 block">Revisa mi código y actividad</span>
              </div>
            </div>
            <span class="text-xs font-semibold text-slate-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

      </div>

      <!-- Formulario de Mensaje -->
      <div class="p-6 sm:p-8 rounded-3xl glass-card border border-slate-200/80 dark:border-slate-800/80">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
          Envíame un mensaje
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
          Rellena este formulario para iniciar una conversación directa.
        </p>

        <form 
          id="contact-form" 
          action={`mailto:${siteConfig.email}`} 
          method="GET" 
          class="space-y-4"
        >
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Tu Nombre:
            </label>
            <input
              type="text"
              id="contact-name"
              required
              placeholder="Ej. Ana García"
              class="w-full px-3.5 py-2.5 rounded-xl text-sm bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Tu Correo:
            </label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="ana@ejemplo.com"
              class="w-full px-3.5 py-2.5 rounded-xl text-sm bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
            />
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Asunto / Motivo:
            </label>
            <input
              type="text"
              id="contact-subject"
              placeholder="Consulta sobre proyecto de Base de Datos / Oportunidad de Pasantía"
              class="w-full px-3.5 py-2.5 rounded-xl text-sm bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Mensaje:
            </label>
            <textarea
              id="contact-message"
              rows="4"
              required
              placeholder="Hola Alex, me interesó mucho tu proyecto de..."
              class="w-full px-3.5 py-2.5 rounded-xl text-sm bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm transition-colors shadow-md hover:shadow-teal-500/25"
          >
            Enviar Mensaje
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>

<script>
  function setupContact() {
    const copyBtn = document.getElementById('copy-email-btn');
    const feedback = document.getElementById('copy-feedback');
    const form = document.getElementById('contact-form');

    if (copyBtn && feedback) {
      copyBtn.addEventListener('click', () => {
        const email = 'tuemail@ejemplo.com';
        navigator.clipboard.writeText(email).then(() => {
          feedback.classList.remove('hidden');
          setTimeout(() => {
            feedback.classList.add('hidden');
          }, 3000);
        });
      });
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
        const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value || 'Contacto desde el Portafolio';
        const msg = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

        const mailtoUri = `mailto:tuemail@ejemplo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(`Nombre: ${name}\n\nMensaje:\n${msg}`)}`;
        window.location.href = mailtoUri;
      });
    }
  }

  setupContact();
  document.addEventListener('astro:after-swap', setupContact);
</script>
