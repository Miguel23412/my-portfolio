---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import TechBadge from '../components/TechBadge.astro';
import { siteConfig } from '../config/site';

const academicTimeline = [
  {
    period: "2026 - Presente (Semestre Actual)",
    title: "6to Semestre - Especialización en Arquitectura & Compiladores",
    institution: siteConfig.university,
    description: "Cursando materias clave como Teoría de Compiladores, Arquitectura de Microservicios, Seguridad Informática y Gestión de Proyectos Ágiles."
  },
  {
    period: "2025",
    title: "5to Semestre - Bases de Datos Avanzadas & Sistemas Embebidos",
    institution: siteConfig.university,
    description: "Desarrollo de proyectos con PostgreSQL, Docker, microcontroladores ESP32 con protocolos IoT (MQTT) y arquitecturas cliente-servidor."
  },
  {
    period: "2025",
    title: "4to Semestre - Estructuras de Datos & Algoritmos",
    institution: siteConfig.university,
    description: "Estudio riguroso de complejidad algorítmica Big-O, grafos, árboles binarios, programación dinámica y concurrencia en C++ y Python."
  },
  {
    period: "2024",
    title: "1er a 3er Semestre - Fundamentos de Ciencias de la Computación",
    institution: siteConfig.university,
    description: "Programación Orientada a Objetos, Álgebra Lineal, Cálculo, Probabilidad Computacional y Fundamentos de Redes."
  }
];
---

<Layout 
  title={`Sobre Mí | ${siteConfig.name}`}
  description={`Conoce la trayectoria académica, habilidades y objetivos profesionales de ${siteConfig.name}.`}
>
  <div class="py-6 max-w-4xl mx-auto space-y-16">
    
    <!-- Hero / Presentación Personal -->
    <section class="flex flex-col md:flex-row items-center gap-8">
      
      <!-- Avatar / Iniciales decorativas -->
      <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-3xl bg-gradient-to-tr from-teal-500 via-cyan-600 to-blue-600 p-1 flex-shrink-0 shadow-xl">
        <div class="w-full h-full rounded-[22px] bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-4xl sm:text-5xl font-mono font-extrabold text-teal-600 dark:text-teal-400">
          MA
        </div>
      </div>

      <!-- Texto de Presentación -->
      <div class="space-y-3 text-center md:text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
          {siteConfig.currentSemester} &bull; {siteConfig.career}
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
          {siteConfig.name}
        </h1>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
          {siteConfig.bio}
        </p>
        <div class="pt-2 flex flex-wrap justify-center md:justify-start gap-3">
          <a
            href={siteConfig.github}
            target="_blank"
            rel="noreferrer"
            class="px-4 py-2 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white text-xs font-semibold transition-colors"
          >
            GitHub
          </a>
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noreferrer"
            class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold transition-colors"
          >
            LinkedIn
          </a>
          <a
            href="/contact"
            class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold transition-colors"
          >
            Contactar por Email
          </a>
        </div>
      </div>

    </section>

    <!-- TRAYECTORIA ACADÉMICA / LÍNEA DE TIEMPO -->
    <section>
      <SectionTitle
        badge="Recorrido Universitario"
        title="Historial Académico"
        subtitle="Evolución de conocimientos y materias cursadas durante la carrera universitaria."
      />

      <div class="relative pl-6 sm:pl-8 border-l-2 border-slate-200 dark:border-slate-800 space-y-10">
        {academicTimeline.map(item => (
          <div class="relative group">
            <!-- Punto en la línea -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-teal-500 border-4 border-white dark:border-slate-950 group-hover:scale-125 transition-transform"></div>
            
            <span class="text-xs font-mono font-semibold text-teal-600 dark:text-teal-400">
              {item.period}
            </span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">
              {item.title}
            </h3>
            <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium mt-0.5">
              {item.institution}
            </span>
            <p class="text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- FILOSOFÍA Y METODOLOGÍA -->
    <section class="p-8 rounded-3xl glass-card space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Mi Enfoque: Combinar Rigor Académico con Desarrollo Práctico
      </h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
        Considero que la universidad brinda los cimientos teóricos sólidos (complejidad temporal, diseño relacional, compiladores y sistemas operativos) necesarios para ser un ingeniero de software de alto nivel. Al mismo tiempo, el desarrollo de proyectos personales me permite estar a la vanguardia de las tecnologías modernas (Astro, React, Docker, Supabase, IA aplicada) y entregar soluciones completas listas para producción.
      </p>
    </section>

  </div>
</Layout>
