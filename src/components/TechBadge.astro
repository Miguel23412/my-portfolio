---
interface Props {
  name: string;
  size?: 'sm' | 'md';
}

const { name, size = 'sm' } = Astro.props;
---

<span class:list={[
  "inline-flex items-center font-mono font-medium rounded-md transition-colors",
  "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-200 dark:hover:bg-slate-700",
  size === 'sm' ? "text-[11px] px-2 py-0.5" : "text-xs px-2.5 py-1"
]}>
  #{name}
</span>
