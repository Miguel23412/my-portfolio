---
interface Props {
  badge?: string;
  badgeType?: 'default' | 'academic' | 'personal';
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { 
  badge, 
  badgeType = 'default', 
  title, 
  subtitle,
  align = 'left' 
} = Astro.props;

const badgeStyles = {
  default: "bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border-teal-200/80 dark:border-teal-800/80",
  academic: "bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border-amber-200/80 dark:border-amber-800/80",
  personal: "bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border-blue-200/80 dark:border-blue-800/80",
};
---

<div class:list={["mb-8 md:mb-12", align === 'center' ? "text-center" : "text-left"]}>
  {badge && (
    <div class:list={["inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border mb-3 shadow-xs", badgeStyles[badgeType]]}>
      <span>{badge}</span>
    </div>
  )}
  <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
    {title}
  </h2>
  {subtitle && (
    <p class:list={["mt-2 text-base text-slate-600 dark:text-slate-400 max-w-2xl", align === 'center' && "mx-auto"]}>
      {subtitle}
    </p>
  )}
</div>
