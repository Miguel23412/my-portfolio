---
import TechBadge from './TechBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, slug } = project;
const isAcademic = data.category === 'academic';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectUrl = `${base}/projects/${slug}`;
---

<article class="group relative flex flex-col rounded-2xl glass-card glass-card-hover overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-slate-950/50">
  
  <!-- Encabezado de la Tarjeta con Badges -->
  <div class="p-5 pb-3">
    <div class="flex items-center justify-between gap-2 mb-3">
      <!-- Badge de Categoría Principal -->
      {isAcademic ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
          Materia: {data.subject || "Académico"}
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/80 shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Proyecto Personal
        </span>
      )}

      <!-- Semestre / Fecha -->
      {data.semester && (
        <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800/60 px-2 py-0.5 rounded-md">
          {data.semester}
        </span>
      )}
    </div>

    <!-- Título del Proyecto -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors leading-snug">
      <a href={projectUrl} class="focus:outline-none">
        <span class="absolute inset-0 z-0"></span>
        {data.title}
      </a>
    </h3>

    <!-- Calificación o Destacado si aplica -->
    {data.grade && (
      <div class="mt-1.5 flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400 font-medium">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>{data.grade}</span>
      </div>
    )}

    <!-- Descripción -->
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
      {data.description}
    </p>
  </div>

  <!-- Tecnologías -->
  <div class="px-5 py-2 flex flex-wrap gap-1.5 z-10">
    {data.tags.slice(0, 4).map(tag => (
      <TechBadge name={tag} size="sm" />
    ))}
    {data.tags.length > 4 && (
      <span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono self-center px-1">
        +{data.tags.length - 4} más
      </span>
    )}
  </div>

  <!-- Footer de la Tarjeta con Enlaces -->
  <div class="mt-auto px-5 py-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between z-10 bg-slate-50/50 dark:bg-slate-900/30">
    <a
      href={projectUrl}
      class="inline-flex items-center gap-1 text-xs font-semibold text-teal-600 dark:text-teal-400 hover:underline"
    >
      <span>Ver detalles</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <div class="flex items-center gap-2">
      {data.githubUrl && (
        <a
          href={data.githubUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={`Repositorio en GitHub de ${data.title}`}
          class="p-1.5 text-slate-500 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      )}

      {data.liveUrl && (
        <a
          href={data.liveUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={`Demo en vivo de ${data.title}`}
          class="p-1.5 text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 rounded-lg hover:bg-teal-50 dark:hover:bg-teal-950 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>

</article>
