---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getHref = (href: string) => href === '/' ? (base ? `${base}/` : '/') : `${base}${href}`;
---

<footer class="w-full border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-950/50 backdrop-blur-sm mt-16 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Info y Universidad -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <span class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
          {siteConfig.name}
          <span class="text-xs px-2 py-0.5 rounded-full bg-teal-100 dark:bg-teal-950 text-teal-700 dark:text-teal-300 font-medium">
            {siteConfig.currentSemester}
          </span>
        </span>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          {siteConfig.career} &bull; {siteConfig.university}
        </p>
      </div>

      <!-- Enlaces rápidos -->
      <div class="flex items-center gap-6 text-sm text-slate-600 dark:text-slate-400">
        <a href={getHref('/projects')} class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">Proyectos</a>
        <a href={getHref('/about')} class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">Sobre Mí</a>
        <a href={getHref('/contact')} class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">Contacto</a>
        <a href={siteConfig.github} target="_blank" rel="noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">GitHub</a>
        <a href={siteConfig.linkedin} target="_blank" rel="noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">LinkedIn</a>
      </div>

      <!-- Copyright & Back to Top -->
      <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <span>&copy; {currentYear} &bull; Creado con <span class="text-teal-500 font-semibold">Astro</span></span>
        <button 
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          aria-label="Volver arriba"
          class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</footer>
